{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic verification verdict",
  "type": "object",
  "required": ["schemaVersion","runId","profile","checks","score","verdict"],
  "properties": {
    "schemaVersion": {"const":1},
    "runId": {"type":"string"},
    "profile": {"enum":["focused","full"]},
    "checks": {"type":"array"},
    "score": {"type":"object","required":["truthScore","coverage"]},
    "verdict": {"enum":["PASS","FAIL","INCOMPLETE","BLOCKED"]}
  }
}
