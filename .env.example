# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical apex for branded tenants (company.example.com)
VITE_ROOT_DOMAIN=example.com

# Authenticated Food RAG / Evidence Assist service (required in production)
VITE_NFI_RAG_URL=https://research-api.example.com

# Sentry (optional — only needed for source map uploads in CI)
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
